# ==============================================================================
# InterviewAI — Root Environment Variable Reference
# ==============================================================================
# This monorepo uses per-application environment files for clarity and separation:
#
#   - apps/web/.env.example          -> Next.js Web App (Vercel / Node)
#   - apps/worker/.env.example       -> Background AI Worker (Render / VM)
#   - apps/ws-server/.env.example    -> Realtime WebSocket Gateway
#   - apps/code-executor/.env.example -> Docker Code Execution Sandbox
#   - packages/database/.env.example -> Prisma Database Migrations
#
# For quick local development, copy the corresponding .env.example files:
#   cp apps/web/.env.example apps/web/.env
#   cp apps/worker/.env.example apps/worker/.env
#   cp apps/ws-server/.env.example apps/ws-server/.env
#   cp apps/code-executor/.env.example apps/code-executor/.env
#   cp packages/database/.env.example packages/database/.env
#
# Core Shared Variables:
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://admin:admin@localhost:5432/interview_ai"
REDIS_URL="redis://localhost:6379"
REALTIME_JWT_SECRET="replace-with-a-random-32-char-secret-string"
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"
AI_PROVIDER="gemini"
AUTH_SECRET="replace-with-a-long-random-string"
# ==============================================================================
