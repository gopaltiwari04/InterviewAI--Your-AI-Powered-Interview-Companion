{
  "name": "InterviewAI",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @repo/engine test:integration && pnpm --filter ws-server test:integration",
    "test:docker": "pnpm --filter code-executor test:docker",
    "test:e2e": "pnpm --filter web test:e2e",
    "verify:problems": "pnpm --filter @repo/problem-bank verify",
    "db:migrate": "pnpm --filter @repo/database migrate:deploy",
    "load:test": "node scripts/load-test.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.18",
    "typescript": "5.9.2",
    "esbuild": "^0.25.12",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
