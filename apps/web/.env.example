# apps/web — Next.js app (Vercel). Copy to apps/web/.env for local development.
# Placeholders only. Never commit real values.

# --- Database (required) ---------------------------------------------------
# Neon/PostgreSQL. On Neon use the POOLED connection string here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- Auth.js (required) ----------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
# Optional locally; on Vercel Auth.js detects the URL automatically.
# AUTH_URL="http://localhost:3000"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Dev/test only: shows a "Test login" button. Ignored by production builds.
# AUTH_TEST_LOGIN="enabled"

# --- Redis (required for code execution, realtime updates and the job queue) -
# Must be the SAME Redis as ws-server, code-executor and worker. Upstash: rediss://default:PASSWORD@HOST:6379
REDIS_URL="redis://localhost:6379"

# --- Realtime (required for live updates) -------------------------------------
# Shared with apps/ws-server. 32+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REALTIME_JWT_SECRET="replace-with-32-plus-random-characters"
# Public URL of the ws-server (inlined into the browser bundle at BUILD time; redeploy after changing).
NEXT_PUBLIC_WS_URL="http://localhost:8080"

# --- AI (optional: the app works without it, with judge-only scores) ---------
GOOGLE_GENERATIVE_AI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"
# 0 disables Gemini 2.5 "thinking" (Flash models). Pro models need a value such as 1024.
# GEMINI_THINKING_BUDGET="0"
# AI_TIMEOUT_MS="30000"
# "mock" = deterministic offline responses for tests (rejected in production).
# AI_PROVIDER="gemini"

# --- Evaluations --------------------------------------------------------------
# auto: use apps/worker when its heartbeat is present, otherwise evaluate inside the web app.
# EVALUATION_MODE="auto"

# LOG_LEVEL="info"
