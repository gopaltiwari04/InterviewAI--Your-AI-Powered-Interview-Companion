{
  "name": "ws-server",
  "version": "2.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ../../scripts/bundle.mjs src/index.ts dist/index.js",
    "start": "node --enable-source-maps dist/index.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "socket.io": "^4.7.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "typescript": "5.9.2",
    "@repo/core": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "vitest": "^3.2.4",
    "socket.io-client": "^4.8.3"
  },
  "private": true
}
