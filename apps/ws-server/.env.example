# apps/ws-server — Socket.IO realtime server (Render). Copy to apps/ws-server/.env locally.
# Placeholders only. Never commit real values.

# Same Redis instance as the web app, executor and worker. Upstash uses rediss:// (TLS).
REDIS_URL="redis://localhost:6379"
# Must equal REALTIME_JWT_SECRET in the web app (32+ characters).
REALTIME_JWT_SECRET="replace-with-32-plus-random-characters"
# Allowed browser origins, comma-separated, no trailing slash. localhost:3000 is added automatically outside production.
CLIENT_URL="http://localhost:3000"
# Render sets PORT automatically.
# PORT="8080"
# NODE_ENV="production"
# LOG_LEVEL="info"
