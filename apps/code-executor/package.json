{
  "name": "code-executor",
  "version": "2.0.0",
  "private": true,
  "description": "Sandboxed coding judge. Needs a Docker-capable host and REDIS_URL only.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ../../scripts/bundle.mjs src/index.ts dist/index.js",
    "start": "node --enable-source-maps dist/index.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:docker": "vitest run --config vitest.docker.config.ts"
  },
  "dependencies": {
    "bullmq": "^5.78.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@repo/core": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/problem-bank": "workspace:*",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "tsx": "^4.22.4",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  }
}
