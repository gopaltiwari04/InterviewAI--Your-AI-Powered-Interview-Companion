# apps/code-executor — sandboxed judge. Runs on a host with Docker (a VM, not serverless).
# This service needs ONLY Redis: it never receives database credentials or AI keys.
# Placeholders only. Never commit real values.

# Same Redis instance as the web app and ws-server.
REDIS_URL="redis://localhost:6379"

# Parallel sandboxes. Each uses up to 1 CPU and 256-512 MB.
# EXECUTOR_CONCURRENCY="2"
# Health endpoint (/health, /ready). Set to 0 to disable.
# EXECUTOR_HEALTH_PORT="8090"
# EXECUTOR_HEALTH_HOST="0.0.0.0"

# Stronger isolation: install gVisor and set the runtime (see DEPLOYMENT.md).
# SANDBOX_RUNTIME="runsc"
# SANDBOX_CPUS="1"
# SANDBOX_PIDS_LIMIT="128"
# Sandboxes delete themselves after this many seconds even if the worker crashes.
# SANDBOX_LIFETIME_SECONDS="240"
# Pull images at startup (recommended).
# SANDBOX_PREPULL="true"
# Pin images (ideally by digest) for reproducible judging.
# SANDBOX_IMAGE_PYTHON="python:3.12-alpine"
# SANDBOX_IMAGE_NODE="node:20-alpine"
# SANDBOX_IMAGE_GCC="gcc:16"
# SANDBOX_IMAGE_JAVA="eclipse-temurin:21-jdk-alpine"
# DOCKER_BIN="docker"
# LOG_LEVEL="info"
